{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm --prefix .. run build && node ../scripts/stage-vercel-app.mjs",
  "installCommand": "npm --prefix .. ci",
  "outputDirectory": "public",
  "regions": ["fra1"],
  "functions": {
    "api/check.mjs": { "maxDuration": 30 },
    "api/index.mjs": { "maxDuration": 60 }
  },
  "redirects": [
    {
      "source": "/",
      "destination": "https://firstbell-server-test.vercel.app",
      "permanent": false,
      "has": [{ "type": "host", "value": { "neq": "firstbell-server-test.vercel.app" } }]
    },
    {
      "source": "/app",
      "destination": "https://firstbell-server-test.vercel.app/app",
      "permanent": false,
      "has": [{ "type": "host", "value": { "neq": "firstbell-server-test.vercel.app" } }]
    },
    {
      "source": "/app/:path*",
      "destination": "https://firstbell-server-test.vercel.app/app/:path*",
      "permanent": false,
      "has": [{ "type": "host", "value": { "neq": "firstbell-server-test.vercel.app" } }]
    }
  ],
  "rewrites": [
    { "source": "/api/check", "destination": "/api/check" },
    { "source": "/server-test", "destination": "/server-test.html" },
    { "source": "/server-test.html", "destination": "/server-test.html" },
    { "source": "/api/:path*", "destination": "/api/index?__fb_path=:path*" },
    { "source": "/app", "destination": "/app/index.html" },
    { "source": "/app/:path*", "destination": "/app/index.html" },
    { "source": "/:path*", "destination": "/index.html" }
  ]
}
