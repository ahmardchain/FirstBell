{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "firstbell",
  "compatibility_date": "2026-09-30",
  "main": "./worker/index.ts",
  "vars": { "PRIVY_APP_ID": "cmun7bqhg00070ck6mdyqp888" },
  "durable_objects": {
    "bindings": [{ "name": "ACCOUNTS", "class_name": "AccountStore" }]
  },
  "exports": {
    "AccountStore": { "type": "durable-object", "storage": "sqlite" }
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  }
}
